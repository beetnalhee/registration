# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 커밋되지 않습니다.
# 운영 환경에서는 Vercel > Project > Settings > Environment Variables 에 등록합니다.
# ─────────────────────────────────────────────────────────────

# Supabase > Project Settings > Database > Connection string > Transaction pooler (port 6543)
# 배정 로직이 pg_advisory_xact_lock 을 사용하므로 transaction pooler 로 충분합니다.
# ★ 끝에 ?sslmode=require 를 반드시 붙이세요. SSL 사용 여부는 이 문자열로만 결정됩니다.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase > Project Settings > API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."

# Gmail SMTP — 반드시 2단계 인증 후 발급한 "앱 비밀번호"(16자리)를 사용하세요.
# https://myaccount.google.com/apppasswords
GMAIL_USER="your-event-account@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
MAIL_FROM_NAME="사랑은 돌아오는거야"

# 이메일 안내문에 넣을 조회 페이지 주소
PUBLIC_BASE_URL="http://localhost:5173"

# 로컬 API 서버 포트 (Vercel 배포 시에는 사용되지 않습니다)
PORT="3001"
